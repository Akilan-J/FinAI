PROJECT_NAME="FinAI"

# development | production. In production, startup fails fast if SECRET_KEY
# or DATABASE_URL are still set to the insecure defaults below.
ENVIRONMENT="development"
FRONTEND_URL="http://localhost:3000"

DATABASE_URL="postgresql+asyncpg://finai_user:finai_password@localhost:5432/finai_db"
REDIS_URL="redis://localhost:6379/0"
CELERY_ALWAYS_EAGER=False
SECRET_KEY="super_secret_session_signing_key_finai_2026"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Agent API Keys
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""

# Outbound email (password reset). Leave SMTP_HOST unset for local dev —
# reset emails will be logged to the console instead of sent.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="no-reply@finai.local"
SMTP_USE_TLS=True

# Optional error tracking (requires `pip install sentry-sdk`)
SENTRY_DSN=""

